@model TrainReservationSystem.Models.ViewModels.ChatbotViewModel

@{
    ViewData["Title"] = "AI Booking Assistant";
}


<div class="container py-4">

    <div class="page-header mb-4">

        <h2>
            <span class="robot-icon">🤖</span>
            AI Booking Assistant
        </h2>

        <p>
            Ask about train availability, seat status,
            demand prediction and booking recommendations.
        </p>

    </div>



    <div class="row">


        <!-- QUICK QUESTIONS -->

        <div class="col-lg-5 mb-4">

            <div class="table-card h-100">


                <div class="card-body p-4">


                    <h5 class="fw-bold mb-3">
                        Quick Questions
                    </h5>


                    <p class="text-muted">
                        Click a question to start.
                    </p>

<div class="quick-grid">

    <button class="quick-btn"
            onclick="askQuestion('List trains')">
        🚆 List Trains
    </button>


    <button class="quick-btn"
            onclick="askQuestion('Available seats on Udarata Menike')">
        💺 Seat Availability
    </button>


    <button class="quick-btn"
            onclick="askQuestion('Demand for Intercity Express')">
        📊 Demand Prediction
    </button>


    <button class="quick-btn"
            onclick="askQuestion('Ticket price for Yal Devi')">
        💰 Price Trend
    </button>


    <button class="quick-btn"
            onclick="askQuestion('Should I book Ruhunu Kumari')">
        ✅ Booking Recommendation
    </button>


    <button class="quick-btn"
            onclick="askQuestion('Which train is busiest')">
        🔥 Busiest Train
    </button>


    <button class="quick-btn"
            onclick="askQuestion('Which train is least busy')">
        🌱 Least Busy Train
    </button>

</div>

                </div>

            </div>

        </div>




        <!-- CHAT AREA -->


        <div class="col-lg-7">


            <div class="table-card">


                <div class="chat-header">

                    <h5>
                        🤖 AI Assistant
                    </h5>

                    <span>
                        Online
                    </span>

                </div>




                <div class="chat-window"
                     id="chatWindow">


                    @if(Model.ChatHistory.Any())
                    {

                        foreach(var message in Model.ChatHistory)
                        {

                            if(message.StartsWith("You:"))
                            {

                                <div class="message user">

                                    @message.Replace(
                                    "You: ",
                                    "")

                                </div>

                            }
                            else
                            {

                                <div class="message bot">

                                    @message.Replace(
                                    "Bot: ",
                                    "")

                                </div>

                            }

                        }

                    }
                    else
                    {

                        <div class="welcome">

                            <div class="big-robot">
                                🤖
                            </div>

                            <h5>
                                Start a conversation
                            </h5>

                            <p>
                                Ask me about trains,
                                seats or demand prediction.
                            </p>

                        </div>

                    }



                    <!-- typing animation -->


                    <div id="typing"
                         class="typing hidden">

                        <span></span>
                        <span></span>
                        <span></span>

                        <small>
                            AI is typing...
                        </small>

                    </div>



                </div>






                <!-- INPUT -->


                <div class="chat-input">


                    <input id="messageInput"
                           class="form-control"
                           placeholder="Ask something..." />


                    <button onclick="sendMessage()"
                            class="send-btn">

                        <i class="bi bi-send-fill"></i>

                        Send

                    </button>


                </div>




                <div class="text-end p-3">

                    <a asp-action="Clear"
                       class="btn btn-outline-danger">

                        🗑 Clear Chat

                    </a>

                </div>


            </div>

        </div>


    </div>

</div>





<style>


.robot-icon{

    display:inline-block;
    animation:pulse 2s infinite;

}



@@keyframes pulse{

    50%{

        transform:scale(1.15);

    }

}




.chat-header{

    padding:18px 25px;

    background:#0B3D91;

    color:white;

    display:flex;

    justify-content:space-between;

    align-items:center;

}


.chat-header span{

    background:#FFC107;

    color:#263238;

    padding:5px 15px;

    border-radius:20px;

    font-size:13px;

}





.chat-window{

    height:450px;

    overflow-y:auto;

    padding:25px;

    background:#fafafa;

}



.message{

    max-width:80%;

    padding:14px 18px;

    margin-bottom:15px;

    border-radius:20px;

    animation:showMessage .4s ease;

    white-space:pre-line;

}




.user{

    margin-left:auto;

    background:#0B3D91;

    color:white;

    border-radius:20px 20px 5px 20px;

}



.bot{

    margin-right:auto;

    background:white;

    border-left:5px solid #FFC107;

    box-shadow:0 3px 10px #ddd;

    border-radius:20px 20px 20px 5px;

}




@@keyframes showMessage{


from{

opacity:0;

transform:translateY(20px);

}


to{

opacity:1;

transform:translateY(0);

}


}






.typing{

    display:flex;

    align-items:center;

    gap:6px;

    padding:10px;

}



.typing span{

    width:9px;

    height:9px;

    background:#FFC107;

    border-radius:50%;

    animation:bounce 1.4s infinite;

}



.typing span:nth-child(2){

    animation-delay:.2s;

}


.typing span:nth-child(3){

    animation-delay:.4s;

}



@@keyframes bounce{


50%{

transform:translateY(-8px);

}


}



.hidden{

    display:none;

}




.chat-input{

    display:flex;

    padding:20px;

    gap:10px;

}



.chat-input input{

    border-radius:30px;

    height:50px;

}



.send-btn{

    border:none;

    background:#0B3D91;

    color:white;

    padding:0 25px;

    border-radius:30px;

}

.quick-grid {

    display: grid !important;

    grid-template-columns: 1fr 1fr !important;

    gap: 12px;

    width:100%;

}



.quick-btn {

    width:100%;

    height:50px;

    border:2px solid #0B3D91;

    background:white;

    color:#0B3D91;

    border-radius:30px;

    font-weight:600;

    font-size:13px;

    display:flex;

    align-items:center;

    justify-content:center;

    white-space:nowrap;

    transition:0.3s ease;

}



.quick-btn:hover {

    background:#0B3D91;

    color:white;

    transform:translateY(-3px);

}

.welcome{

    text-align:center;

    padding-top:100px;

    color:#777;

}



.big-robot{

    font-size:70px;

    animation:pulse 2s infinite;

}



</style>





@section Scripts{


<script>


const chatWindow =
document.getElementById("chatWindow");


const input =
document.getElementById("messageInput");


const typing =
document.getElementById("typing");





function scrollBottom(){

    chatWindow.scrollTop =
    chatWindow.scrollHeight;

}





function askQuestion(text){

    input.value=text;

    sendMessage();

}





async function sendMessage(){


    let message =
    input.value.trim();


    if(message==="")
        return;



    addMessage(
        message,
        "user"
    );


    input.value="";



    typing.classList.remove(
        "hidden"
    );


    scrollBottom();




    const response =
    await fetch(
        '/Chatbot/Ask',
        {

            method:"POST",

            headers:
            {
                "Content-Type":
                "application/json"
            },

            body:
            JSON.stringify(
            {
                message:message
            })

        });



    const data =
    await response.json();




    setTimeout(()=>{


        typing.classList.add(
            "hidden"
        );


        addMessage(
            data.response,
            "bot"
        );


    },800);



}





function addMessage(
text,
type)
{


    let div =
    document.createElement(
        "div"
    );


    div.className =
    "message " + type;


    div.innerText=text;



    chatWindow.appendChild(div);


    scrollBottom();

}



scrollBottom();



</script>


}