<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Train Reservation System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/TrainReservationSystem.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/train-theme.css" asp-append-version="true" />

    <style>
            :root {

                --primary: #0B3D91;
                --primary-dark: #082C6C;
                --secondary: #1E88E5;
                --accent: #FFC107;
                --background: #F4F7FC;
                --text: #263238;
                --text-light: #607D8B;

            }

            html,
            body {

                margin: 0;
                padding: 0;
                overflow-x: hidden;
                background: var(--background);

            }

            /* ===========================
                                        NAVBAR
                                ============================ */

            .custom-navbar {

                background: #fff;

                padding: 10px 0;

                border-bottom: 1px solid #e9ecef;

                box-shadow: 0 2px 12px rgba(0, 0, 0, .06);

                transition: .3s ease;

                z-index: 1030;

            }

            .custom-navbar.scrolled {

                box-shadow: 0 8px 22px rgba(0, 0, 0, .10);

            }

            /* ===========================
                                        BRAND
                                ============================ */

            .navbar-brand {

                display: flex;

                align-items: center;

                text-decoration: none;

            }

            .site-logo {

                width: 36px;

                height: 36px;

                object-fit: contain;

                transition: .3s;

            }

            .navbar-brand:hover .site-logo {

                transform: scale(1.08);

            }

            .logo-title {

                color: var(--primary);

                font-size: 1.15rem;

                font-weight: 700;

                line-height: 1.1;

            }

            .logo-subtitle {

                color: var(--text-light);

                font-size: .72rem;

                letter-spacing: .6px;

            }

            /* ===========================
                                        NAV LINKS
                                ============================ */

            .navbar-nav .nav-link {

                color: var(--text) !important;

                font-weight: 500;

                margin: 0 6px;

                padding: 10px 18px !important;

                border-radius: 30px;

                transition: all .25s ease;

            }

            .navbar-nav .nav-link:hover {

                color: var(--primary) !important;

                background: #EEF4FF;

            }

            .navbar-nav .nav-link.active {

                background: var(--primary);

                color: #fff !important;

                font-weight: 600;

            }

            /* ===========================
                                        AI BUTTON
                                ============================ */

            .ai-btn {

                background: var(--accent);

                color: var(--primary) !important;

                border: none;

                border-radius: 30px;

                padding: 10px 24px;

                font-weight: 600;

                transition: .3s;

            }

            .ai-btn:hover {

                background: #FFD54F;

                color: var(--primary) !important;

                transform: translateY(-2px);

                box-shadow: 0 8px 20px rgba(255, 193, 7, .30);

            }

            /* ===========================
                                        TOGGLER
                                ============================ */

            .navbar-toggler {

                border: none;

            }

            .navbar-toggler:focus {

                box-shadow: none;

            }

            /* ===========================
                                        MAIN
                                ============================ */

            main {

                margin: 0;

                padding: 0;

            }

            /* ===========================
                                        FOOTER
                                ============================ */

            footer {

                background: #fff;

                border-top: 1px solid #e9ecef;

                padding: 18px 0;

            }

            /* ===========================
                                        MOBILE
                                ============================ */

            @@media(max-width:991px) {

                .navbar-collapse {

                    background: #fff;

                    margin-top: 15px;

                    padding: 15px;

                    border-radius: 15px;

                    box-shadow: 0 10px 25px rgba(0, 0, 0, .08);

                }

                .navbar-nav .nav-link {

                    margin: 5px 0;

                }

                .ai-btn {

                    width: 100%;

                    margin-top: 12px;

                }

                

            }

            /* ===========================
                        PAGE CONTENT SPACING
                   =========================== */

            .page-container {

                padding-top: 95px;

                padding-left: 25px;

                padding-right: 25px;

                padding-bottom: 40px;

            }


            /* Keep homepage full screen */

            .home-page {

                padding-top: 0;

            }



            /* Footer */

            footer {

                margin-top: 30px;

            }


            /* Mobile */

            @@media(max-width:768px) {

                .page-container {

                    padding-left: 15px;

                    padding-right: 15px;

                    padding-top: 90px;

                }

            }

            .navbar-toggler-icon {

                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(11,61,145,1)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");

            }
    </style>

</head>

<body>

    @{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isLoginPage = controller == "Account" && action == "Login";
}

@if (!isLoginPage)
{
    <header>

        <nav class="navbar navbar-expand-lg fixed-top custom-navbar">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">

                    <img src="~/images/logo.png" asp-append-version="true" class="site-logo"
                         alt="Train Reservation System Logo" />

                    <div class="ms-2">

                        <div class="logo-title">
                            Train Reservation
                        </div>

                        <small class="logo-subtitle">
                            Management System
                        </small>

                    </div>

                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(controller == "Booking" ? "active" : "")" asp-controller="Booking"
                               asp-action="Index">

                                Bookings

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(controller == "Schedule" ? "active" : "")" asp-controller="Schedule"
                               asp-action="Index">

                                Schedules

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(controller == "SpecialRequest" ? "active" : "")"
                               asp-controller="SpecialRequest" asp-action="Index">

                                Requests

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(controller == "Report" ? "active" : "")" asp-controller="Report"
                               asp-action="WeeklyBookings">

                                Reports

                            </a>

                        </li>

                        <li class="nav-item ms-lg-3">

                            <a asp-controller="Chatbot" asp-action="Index" class="btn ai-btn">

                                🤖 AI Assistant

                            </a>

                        </li>

  @if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <li class="nav-item ms-lg-3">
        <span class="navbar-text fw-semibold text-primary">
            Welcome, @User.Identity.Name
        </span>
    </li>

    <li class="nav-item ms-2">
        <a asp-controller="Account"
           asp-action="Logout"
           class="btn btn-outline-danger rounded-pill px-3">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </li>
}
else
{
    <li class="nav-item ms-lg-3">
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary rounded-pill px-3">
            <i class="bi bi-box-arrow-in-right"></i> Login
        </a>
    </li>
}

                    </ul>

                </div>

            </div>

        </nav>

    </header>
}
    @if (controller == "Home")
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container page-container">

            <main role="main">
                @RenderBody()
            </main>

        </div>
    }

    <footer class="border-top text-muted">

        <div class="container text-center">

            © 2026 Train Reservation System

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>

        window.addEventListener("scroll", function () {

        const navbar = document.querySelector(".custom-navbar");

        if (window.scrollY > 50) {

        navbar.classList.add("scrolled");

        }
        else {

        navbar.classList.remove("scrolled");

        }

        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>