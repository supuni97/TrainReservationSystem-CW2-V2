@model TrainReservationSystem.Models.SpecialRequest

@{
    ViewData["Title"] = "Delete Special Request";
}



<div class="container mt-4">


    <div class="page-card delete-box">


        <div class="page-header bg-danger">


            <h3>
                Delete Special Request
            </h3>


        </div>



        <div class="p-4">



            <p class="fs-5">

                Are you sure you want to delete this special request?

            </p>



            <h4 class="text-primary">

                @Model.RequestType

            </h4>



            <hr />



            <table class="table table-bordered details-table">


                <tr>

                    <th width="250">
                        Booking ID
                    </th>

                    <td>
                        @Model.BookingId
                    </td>

                </tr>



                <tr>

                    <th>
                        Description
                    </th>

                    <td>
                        @Model.Description
                    </td>

                </tr>



                <tr>

                    <th>
                        Status
                    </th>

                    <td>
                        @Model.Status
                    </td>

                </tr>



            </table>




            <form asp-action="Delete">


                <input asp-for="Id" type="hidden" />



                <button type="submit"
                        class="btn btn-danger px-4">

                    <i class="bi bi-trash-fill"></i>

                    Delete


                </button>



                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">


                    Cancel


                </a>



            </form>



        </div>



    </div>



</div>